  <script is:inline>
    document.querySelectorAll(".copy").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const el = document.getElementById(btn.getAttribute("data-copy-target"));
        if (!el) return;
        try {
          // data-full carries the complete command when the display is abbreviated
          // (the install line hides the manager token, which the dropdown shows).
          await navigator.clipboard.writeText((el.dataset.full ?? el.textContent).trim());
          const prev = btn.textContent;
          btn.textContent = "Copied ✓";
          setTimeout(() => (btn.textContent = prev), 1400);
        } catch {}
      });
    });
  </script>

  <script is:inline>
    // Package-manager picker: swap the shown command, remember the choice. The visible
    // text omits the manager token (the dropdown shows it); data-full keeps the whole
    // command so the copy button still yields something runnable.
    (function () {
      const select = document.getElementById("pm-select");
      const out = document.getElementById("install-cmd");
      const LOGOS = document.querySelector("#pm-face-logo use")?.getAttribute("href")?.split("#")[0] ?? "";
      if (!select || !out) return;
      const KEY = "runcommand:pm";
      const apply = () => {
        const opt = select.selectedOptions[0];
        if (!opt || !opt.dataset.cmd) return;
        out.textContent = opt.dataset.cmdShown ?? opt.dataset.cmd;
        out.dataset.full = opt.dataset.cmd;
        // Keep the fallback trigger face in step; it is the only mark WebKit shows.
        const faceLogo = document.querySelector("#pm-face-logo use");
        const faceLabel = document.getElementById("pm-face-label");
        if (faceLogo) faceLogo.setAttribute("href", `${LOGOS}#${opt.value}`);
        if (faceLabel) faceLabel.textContent = opt.textContent.trim();
      };
      try {
        const saved = localStorage.getItem(KEY);
        if (saved && [...select.options].some((o) => o.value === saved)) select.value = saved;
      } catch {}
      apply();
      select.addEventListener("change", () => {
        apply();
        try { localStorage.setItem(KEY, select.value); } catch {}
      });
    })();

    // Escape closes an open hint without moving the pointer or focus, which the
    // CSS-only version can't do on its own. Cleared on leave so it reopens later.
    (function () {
      const wraps = document.querySelectorAll(".hint-wrap");
      if (!wraps.length) return;
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") wraps.forEach((w) => w.setAttribute("data-hint-dismissed", ""));
      });
      wraps.forEach((wrap) => {
        const clear = () => wrap.removeAttribute("data-hint-dismissed");
        wrap.addEventListener("pointerleave", clear);
        wrap.addEventListener("focusout", clear);
      });
    })();
  </script>

  <script is:inline>
    (function () {
      const dialog = document.getElementById("surface-preview");
      const image = document.getElementById("preview-image");
      const title = document.getElementById("preview-title");
      const caption = document.getElementById("preview-caption");
      const closeButton = document.querySelector("[data-close-preview]");
      if (!(dialog instanceof HTMLDialogElement) || !(image instanceof HTMLImageElement) || !title || !caption || !closeButton) return;

      const closeDialog = () => {
        if (!dialog.open || dialog.classList.contains("is-closing")) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          dialog.close();
          return;
        }

        dialog.classList.add("is-closing");
        const finish = () => {
          if (!dialog.classList.contains("is-closing")) return;
          dialog.removeEventListener("transitionend", onTransitionEnd);
          dialog.classList.remove("is-closing");
          dialog.close();
        };
        const onTransitionEnd = (event) => {
          if (event.target === dialog && event.propertyName === "opacity") finish();
        };
        dialog.addEventListener("transitionend", onTransitionEnd);
        window.setTimeout(finish, 260);
      };

      document.querySelectorAll("[data-preview-src]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          dialog.classList.remove("is-closing");
          image.src = trigger.dataset.previewSrc;
          image.alt = trigger.dataset.previewAlt || "";
          image.width = Number(trigger.dataset.previewWidth) || 900;
          image.height = Number(trigger.dataset.previewHeight) || 158;
          title.textContent = trigger.dataset.previewTitle || "runcommand preview";
          caption.textContent = trigger.dataset.previewCaption || "";
          dialog.showModal();
        });
      });

      closeButton.addEventListener("click", closeDialog);
      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeDialog();
      });
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const inside = rect.top <= event.clientY && event.clientY <= rect.bottom && rect.left <= event.clientX && event.clientX <= rect.right;
        if (!inside) closeDialog();
      });
    })();
  </script>

  <script is:inline>
    // Hero widget: loops the /runcommand detection — types, "finds", reveals the
    // command + port, holds, repeats. Only animates while in view; reduced-motion &
    // no-JS just show the final state (which lives in the markup).
    (function () {
      const w = document.getElementById("cc-widget");
      const typed = document.getElementById("cc-typed");
      const cursor = document.getElementById("cc-cursor");
      const context = document.getElementById("cc-context");
      const run = document.getElementById("cc-run");
      if (!w || !typed || !context || !run) return;
      const CMD = "/runcommand";
      const RESULT = run.innerHTML; // captured final state from the markup
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
      let visible = true, looping = false; // hero is on-screen at load; IO pauses it if scrolled away
      async function cycle() {
        if (looping) return;
        looping = true;
        while (visible) {
          context.textContent = "42%";
          typed.textContent = "";
          if (cursor) cursor.hidden = false;
          run.innerHTML = "";
          for (const ch of CMD) { if (!visible) break; typed.textContent += ch; await sleep(60); }
          await sleep(380);
          if (cursor) cursor.hidden = true;
          run.innerHTML = '<span class="dim">▶ finding run command<span class="cc-dots"></span></span>';
          const dots = run.querySelector(".cc-dots");
          let n = 0;
          const t = setInterval(() => { n = (n + 1) % 4; dots.textContent = ".".repeat(n); }, 250);
          await sleep(1450);
          clearInterval(t);
          context.textContent = "43%";
          run.innerHTML = RESULT;
          run.classList.add("cc-reveal");
          setTimeout(() => run.classList.remove("cc-reveal"), 400);
          await sleep(3500); // hold on the result, then loop
        }
        looping = false;
      }
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const io = new IntersectionObserver((es) => {
        visible = es[0].isIntersecting;
        if (visible) cycle();
      }, { threshold: 0.4 });
      io.observe(w);
      cycle(); // start immediately; don't wait on the observer's first callback
    })();
  </script>

