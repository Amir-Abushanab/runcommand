---
import Layout from "../layouts/Layout.astro";
import Terminal from "../components/Terminal.astro";
import { Code } from "astro:components";
import statusbarShot from "../../../assets/shot-statusbar.svg";
import starshipShot from "../../../assets/shot-starship.svg";
import { readFileSync } from "node:fs";
import { execSync } from "node:child_process";

const repo = "https://github.com/amir-abushanab/runcommand";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const codeThemes = { light: "github-light", dark: "github-dark" } as const;
const inlineCodeTransformers = [{
  name: "remove-inline-tabindex",
  pre(node: { properties: Record<string, unknown> }) {
    delete node.properties.tabindex;
  },
}];

// Build stamp for the footer: CLI version (root package.json) + short commit.
const version = JSON.parse(readFileSync(new URL("../../../package.json", import.meta.url), "utf8")).version;
let commit = "";
try { commit = execSync("git rev-parse --short HEAD", { encoding: "utf8" }).trim(); } catch {}

// Inline a vendored favicon; onerror removes it, so a bad load leaves no broken
// icon (the fallback is no icon, never a misrendered one).
const favImg = (file) => `<img class="tool-fav" src="${base}/favicons/${file}" alt="" width="14" height="14" loading="lazy" onerror="this.remove()">`;
// A tool name linked to its site with its favicon. Omit `file` for no icon.
const toolLink = (href, label, file) => `<a class="tool-link" href="${href}" target="_blank" rel="noopener">${file ? favImg(file) : ""}<span>${label}</span></a>`;
const commandExample = (logo, command) => `<span class="command-example"><svg class="command-logo" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><use href="${base}/logos/command-logos.svg#${logo}"></use></svg><code>${command}</code></span>`;

const cacheExample = `// Usually: ~/.cache/runcommand/<project-hash>.json
{
  "root": "/Users/you/Code/app",
  "commands": [
    {
      "command": "pnpm dev"
    }
  ],
  "source": "llm",
  "agent": "claude",
  "signalsHash": "7cf0d4…",
  "detectedAt": 1786924800000
}`;

const features = [
  { icon: "◆", color: "light-dark(#0e7490,#22d3ee)", title: "Detects the command", body: `An installed AI CLI reads the project and returns the command it expects: ${commandExample("pnpm", "pnpm dev")}, ${commandExample("python", "uvicorn main:app")}, ${commandExample("rails", "bin/rails server")}, ${commandExample("rust", "cargo run")}, ${commandExample("go", "go run .")}, ${commandExample("elixir", "mix phx.server")}, ${commandExample("dotnet", "dotnet run")}, ${commandExample("gradle", "./gradlew bootRun")}, ${commandExample("docker", "docker compose up")}, and more.`, visual: "detect", example: null },
  { icon: "↯", color: "light-dark(#0f766e,#2dd4bf)", title: "Reads from a cache", body: "Each project is detected once. Status lines read a machine-managed JSON cache; a miss starts detection in the background. A cache entry looks like this:", visual: "cache", example: cacheExample },
  { icon: "↻", color: "light-dark(#0369a1,#38bdf8)", title: "Refreshes after changes", body: "The cache key includes the project's manifests. Change a script or Make target and the next render schedules a new detection.", visual: "refresh", example: null },
  { icon: "◉", color: "light-dark(#1d4ed8,#60a5fa)", title: "Finds project ports", body: "Lists listening ports owned by processes inside the current project. Ports from databases and other projects are excluded.", visual: "ports", example: null },
  { icon: "▤", color: "light-dark(#4f46e5,#818cf8)", title: "Fits existing tools", body: `One binary, rendered by whatever status bar or prompt you already run. <code>runcommand init</code> wires up what it finds and keeps the status line you already had.`, visual: "tools", example: null },
  { icon: "✦", color: "light-dark(#7c3aed,#a78bfa)", title: "Handles multiple services", body: "Labels each command in a monorepo and assigns distinct colours. The labels keep services identifiable without relying on colour alone.", visual: "services", example: null },
];

// One per category — agent, shell prompt, multiplexer — so the row set reads as
// "anywhere", not "four AI tools". tmux ships no favicon, so it uses a text mark
// like the integrations list does.
const featureHosts = [
  { icon: "claude.svg", mark: null, label: "Claude Code" },
  { icon: "starship.png", mark: null, label: "starship" },
  { icon: null, mark: "tm", label: "tmux" },
];

const commands = [
  ["init", "Find supported tools and configure them  ·  --dry-run --yes --surfaces"],
  ["statusline", "Print the command and live ports for Claude Code or Qwen Code"],
  ["prompt", "Print the cached command for a shell prompt"],
  ["promptline", "Print a styled command and clickable ports for starship"],
  ["ports", "List this project's live localhost ports  ·  --links --urls --json --all"],
  ["json", "Return { commands, ports } for integrations such as OpenCode"],
  ["detect", "Run detection now, then print and cache the result"],
  ["get", "Print the cached command; detect it if missing"],
  ["refresh", "Run detection again  ·  --hint \"correction\" --clear-hint"],
  ["path", "Print the cache file path for a project"],
  ["agents", "List detection agents  ·  --probe tests each one"],
  ["uninstall", "Remove runcommand's config and restore backups"],
];

const terminals = [
  { slug: "ghostty", name: "Ghostty", color: "#3551F3", osc8: true },
  { slug: "iterm2", name: "iTerm2", color: "var(--text)", osc8: true },
  { slug: "wezterm", name: "WezTerm", color: "#4E49EE", osc8: true },
  { slug: "kitty", name: "kitty", color: "#C0C81F", osc8: true },
  { slug: "alacritty", name: "Alacritty", color: "#F46D01", osc8: true },
  { slug: "warp", name: "Warp", color: "#01A4FF", osc8: true },
  { slug: "windowsterminal", name: "Windows Terminal", color: "#4CC2FF", osc8: true },
  { slug: "visualstudiocode", name: "VS Code", color: "#0098FF", osc8: true },
  { slug: "gnometerminal", name: "GNOME Terminal", color: "var(--text)", osc8: true },
  { slug: "apple", name: "Apple Terminal", color: "var(--text)", osc8: false },
];

// Install command per package manager. pnpm leads because that's what this project
// uses; the rest are here so nobody has to translate the flags themselves.
//
// The manager's name is shown by the dropdown, so the command line drops its leading
// token and starts at the verb — "add -g …", not "pnpm add -g …". What gets COPIED is
// still the whole thing, carried on data-cmd; only the display is trimmed.
const packageManagers = [
  { id: "pnpm", label: "pnpm", cmd: "pnpm add -g @amabush/runcommand" },
  { id: "npm", label: "npm", cmd: "npm i -g @amabush/runcommand" },
  { id: "yarn", label: "yarn", cmd: "yarn global add @amabush/runcommand" },
  { id: "bun", label: "bun", cmd: "bun add -g @amabush/runcommand" },
];
const fullCmd = (pm) => `${pm.cmd} && runcommand init`;
/** The same command minus its leading manager token, which the dropdown already shows. */
const shownCmd = (pm) => `${pm.cmd.split(" ").slice(1).join(" ")} && runcommand init`;

const installNote = `<code>init</code> finds supported tools, updates their config, and backs up changed files. It needs Node and one supported AI CLI for detection. <a href="${repo}" rel="noopener">Read the setup guide &rarr;</a>`;

const surfaceTools = [
  {
    category: "Tool", name: "Claude Code", suffix: "", detail: "Status line", icon: `${base}/favicons/claude.svg`, logo: null, color: null, mark: null,
    preview: { src: statusbarShot.src, title: "Claude Code status line", alt: "Claude Code status line showing pnpm dev and ports 3000 and 5173", caption: "The cached command and current project ports appear below Claude Code's own status line.", width: 900, height: 158 },
  },
  { category: "Tool", name: "Qwen Code", suffix: "", detail: "Status line", icon: `${base}/favicons/qwen.png`, logo: null, color: null, mark: null, preview: null },
  { category: "Tool", name: "OpenCode", suffix: "", detail: "TUI footer", icon: `${base}/favicons/opencode.svg`, logo: null, color: null, mark: null, preview: null },
  {
    category: "Tool", name: "starship", suffix: "", detail: "Shell prompt", icon: `${base}/favicons/starship.png`, logo: null, color: null, mark: null,
    preview: { src: starshipShot.src, title: "starship shell prompt", alt: "Starship prompt showing pnpm dev and port 5173 beside the current directory and branch", caption: "The custom starship module prints the cached command and makes each compact port an OSC 8 link.", width: 900, height: 158 },
  },
  { category: "Tool", name: "tmux", suffix: "", detail: "Status bar", icon: null, logo: null, color: null, mark: "tm", preview: null },
  { category: "Tool", name: "zellij", suffix: "", detail: "Status bar", icon: null, logo: null, color: null, mark: "zj", preview: null },
];

const surfaceItems = [
  ...surfaceTools,
  ...terminals.map((terminal) => ({
    category: "Terminal",
    name: terminal.name,
    suffix: terminal.osc8 === false ? "*" : "",
    detail: terminal.osc8 === false ? "Full URL links" : "OSC 8 links",
    icon: null,
    logo: terminal.slug,
    color: terminal.color,
    mark: null,
    preview: terminal.osc8 === false ? null : {
      src: starshipShot.src,
      title: `${terminal.name} terminal`,
      alt: `A shell prompt showing pnpm dev and a compact localhost port link in ${terminal.name}`,
      caption: `The prompt layout comes from starship. In ${terminal.name}, compact ports use OSC 8 links.`,
      width: 900,
      height: 158,
    },
  })),
];

const GH_PATH = "M8 .2a8 8 0 00-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.49c-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.2c0 .21.15.46.55.38A8 8 0 008 .2z";
---

<Layout
  title="runcommand: project run commands in your status line"
  description="A dependency-free CLI that detects a project's run command, caches it, and shows it with live local ports in status lines and shell prompts."
>
  <header class="nav">
    <div class="wrap nav-in">
      <a class="brand" href="#top"><span class="brand-mark">▶</span> runcommand</a>
      <nav class="nav-links">
        <a href="#features">How it works</a>
        <a href="#surfaces">Integrations</a>
        <a href="#commands">Commands</a>
        <a href={repo} rel="noopener" class="nav-gh">
          <svg class="gh-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d={GH_PATH} /></svg>
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-in">
        <div class="hero-copy">
          <h1>Never hunt for the run command again.</h1>
          <p class="lead">
            Juggling a dozen repos? <strong>runcommand</strong> works out how to start each
            one (<code>pnpm dev</code>, <code>cargo run</code>, <code>docker compose up</code>)
            and shows it next to the localhost ports it's actually serving, right in your
            status bar and prompt.
          </p>
          <div class="cta">
            <a class="btn btn-primary" href="#features">See how it works</a>
            <a class="btn btn-ghost" href={repo} rel="noopener">
              <svg class="gh-icon" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d={GH_PATH} /></svg>
              View on GitHub
            </a>
          </div>
          <div class="install">
            <label class="sr-only" for="pm-select">Package manager</label>
            <span class="pm-picker">
              {/* The visible trigger. `appearance: base-select` can style the real select
                  and clone the chosen option into <selectedcontent>, mark and all — but
                  only in Chromium. Everywhere else a native select renders text only, so
                  the brand mark would simply never appear. This face is what carries it
                  there; the native select sits on top of it, transparent, so the control
                  is still a real select for keyboard, mobile and assistive tech. */}
              <span class="pm-face" aria-hidden="true">
                <svg class="pm-logo" id="pm-face-logo" viewBox="0 0 24 24" width="14" height="14"><use href={`${base}/logos/command-logos.svg#${packageManagers[0].id}`}></use></svg>
                <span id="pm-face-label">{packageManagers[0].label}</span>
                <svg class="pm-face-caret" viewBox="0 0 10 6" width="9" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            {/* A plain native select — nothing but <option>s inside it. An earlier
                version nested <button><selectedcontent> to opt into
                `appearance: base-select`, which renders the mark inside the control
                itself; that is Chromium-only, and browsers disagree about what to do
                with the extra markup, which showed up in WebKit as the label drawn
                twice, overlapping. The mark now lives in .pm-face for every browser
                and this stays a stock select. */}
            <select id="pm-select" class="pm-select">
              {packageManagers.map((pm) => (
                <option value={pm.id} selected={pm.id === "pnpm"} data-cmd={fullCmd(pm)} data-cmd-shown={shownCmd(pm)}>{pm.label}</option>
              ))}
            </select>
            </span>
            <code id="install-cmd" data-full={fullCmd(packageManagers[0])}>{shownCmd(packageManagers[0])}</code>
            <button class="copy" type="button" data-copy-target="install-cmd" aria-label="Copy command">Copy</button>
          </div>
          <p class="install-note" set:html={installNote}></p>
        </div>

        <div class="hero-demo" id="cc-widget" role="img"
             aria-label="In Claude Code, the /runcommand slash command detects the run command and shows it in the status line: pnpm dev, serving localhost:5173.">
          <Terminal title="Claude Code" caption="Run /runcommand to detect the command and list current ports.">
<span class="cc-box"><span class="cc-caret">&gt;</span> <span id="cc-typed" class="cc-typed">/runcommand</span><span id="cc-cursor" class="cc-cursor" hidden>▍</span></span>
<span class="ln"><span class="dim">[Opus] · principlestash.com · <span id="cc-context">43%</span> context</span></span>
<span class="ln" id="cc-run"><span class="dim">▶</span> <span class="cyan">pnpm dev</span>  <span class="dim">◉</span> <span class="cc-port">:5173</span></span>
          </Terminal>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="features">
      <div class="wrap">
        <p class="eyebrow">Features</p>
        <h2>What runcommand does</h2>
        <ul class="cards" role="list">
          {features.map((f) => (
            <li class="card">
              <span class="card-icon" aria-hidden="true" style={`color:${f.color}`}>{f.icon}</span>
              <h3>{f.title}</h3>
              <p set:html={f.body}></p>
              {f.visual === "detect" && (
                <div class="card-visual feature-demo feature-detect" aria-hidden="true">
                  <span class="visual-kicker">Project signals</span>
                  <div class="visual-chip-row">
                    <span class="visual-chip">package.json</span>
                    <span class="visual-chip">pyproject.toml</span>
                    <span class="visual-chip">Gemfile</span>
                    <span class="visual-chip">Cargo.toml</span>
                    <span class="visual-chip">Makefile</span>
                  </div>
                  <div class="visual-result"><span>▶</span><code>pnpm dev</code></div>
                </div>
              )}
              {f.example && (
                <Code class="card-visual cache-example" code={f.example} lang="jsonc" themes={codeThemes} tabindex="0" />
              )}
              {f.visual === "refresh" && (
                <div class="card-visual feature-demo feature-refresh" aria-hidden="true">
                  <span class="visual-kicker">Manifest fingerprint</span>
                  <div class="refresh-row"><span class="refresh-mark is-change">~</span><code>package.json</code><span>changed</span></div>
                  <div class="refresh-row"><span class="refresh-mark">↻</span><span>detecting again</span></div>
                  <div class="refresh-row"><span class="refresh-mark is-done">✓</span><code>pnpm run dev:web</code></div>
                </div>
              )}
              {f.visual === "ports" && (
                <div class="card-visual feature-demo feature-ports" aria-hidden="true">
                  <span class="visual-kicker">Listening in this project</span>
                  <div class="visual-result"><span>▶</span><code>pnpm dev</code></div>
                  <div class="visual-port-row"><span><i></i>:3000</span><span><i></i>:5173</span></div>
                </div>
              )}
              {f.visual === "tools" && (
                <div class="card-visual feature-demo feature-hosts" aria-hidden="true">
                  <span class="visual-kicker">One line, every surface</span>
                  {featureHosts.map((h) => (
                    <div class="host-row">
                      {h.icon
                        ? <img class="host-icon" src={`${base}/favicons/${h.icon}`} alt="" width="18" height="18" loading="lazy" />
                        : <span class="host-mark">{h.mark}</span>}
                      <span class="host-name">{h.label}</span>
                      <code>▶ pnpm dev</code>
                    </div>
                  ))}
                </div>
              )}
              {f.visual === "services" && (
                <div class="card-visual feature-demo feature-services" aria-hidden="true">
                  <span class="visual-kicker">monorepo · web + api</span>
                  <div class="service-row"><span class="service-label is-web">web</span><code>pnpm dev:web</code><span class="service-port">:5173</span></div>
                  <div class="service-row"><span class="service-label is-api">api</span><code>pnpm dev:api</code><span class="service-port">:3000</span></div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- SURFACES -->
    <section id="surfaces" class="surfaces">
      <div class="wrap">
        <p class="eyebrow">Integrations</p>
        <h2>Status lines, prompts, and terminal links.</h2>
        <p class="lead">runcommand writes the cached command to each tool's available UI, and leans on whichever AI CLI you already have to work that command out in the first place. Ports use <span class="hint-wrap"><a
          class="hint"
          href="https://gist.github.com/egmontkob/eb114294efbcd5adb1944c9f3cb5feda"
          target="_blank"
          rel="noopener"
          aria-describedby="osc8-hint"
        >OSC 8 links</a><span class="hint-bubble" id="osc8-hint" role="tooltip">An escape sequence that makes terminal text a real hyperlink, so a short <code>:5173</code> is clickable without printing the whole URL. Not every terminal supports it — those get the full address instead. Opens the reference ↗</span></span> where the terminal supports them. Click a terminal or tool to open its screenshot when one is available.</p>

        <ul class="surface-list" role="list">
          {surfaceItems.map((item) => (
            <li class="surface-item">
              <button
                class="surface-trigger"
                type="button"
                disabled={!item.preview}
                data-preview-src={item.preview?.src}
                data-preview-title={item.preview?.title}
                data-preview-alt={item.preview?.alt}
                data-preview-caption={item.preview?.caption}
                data-preview-width={item.preview?.width}
                data-preview-height={item.preview?.height}
                aria-label={item.preview ? `View ${item.name} screenshot` : undefined}
              >
                <span class="surface-ident">
                  {item.icon && <img class="surface-icon-img" src={item.icon} alt="" width="28" height="28" loading="lazy" />}
                  {item.logo && <span class="surface-logo" aria-hidden="true" style={`--logo:url("${base}/logos/${item.logo}.svg");--brand:${item.color}`}></span>}
                  {item.mark && <span class="surface-mark" aria-hidden="true">{item.mark}</span>}
                  <span>
                    <span class="surface-name">{item.name}{item.suffix}</span>
                    <span class="surface-detail">{item.detail}</span>
                  </span>
                </span>
                <span class="surface-meta">
                  <span class="surface-kind">{item.category}</span>
                  {!item.preview && <span class="surface-static">Supported</span>}
                </span>
              </button>
            </li>
          ))}
        </ul>
        <p class="compat-note">
          <strong>*</strong> Apple Terminal does not support OSC 8. There, the <code>url</code> port style prints
          {" "}<code>http://localhost:PORT</code> so the terminal can detect the link. Konsole, foot,
          and other OSC 8 terminals work as well.
        </p>

        <dialog id="surface-preview" class="preview-dialog" closedby="closerequest" aria-labelledby="preview-title" aria-describedby="preview-caption">
          <div class="preview-panel">
            <form class="preview-close-form">
              <button class="preview-close" type="button" data-close-preview aria-label="Close screenshot">×</button>
            </form>
            <p class="eyebrow">Screenshot</p>
            <h3 id="preview-title"></h3>
            <div class="preview-image-wrap">
              <img id="preview-image" src={statusbarShot.src} alt="" width="900" height="158" />
            </div>
            <p id="preview-caption"></p>
          </div>
        </dialog>
      </div>
    </section>

    <!-- COMMANDS -->
    <section id="commands" class="commands">
      <div class="wrap">
        <p class="eyebrow">Reference</p>
        <h2>Commands</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th scope="col">Command</th><th scope="col">What it does</th></tr>
            </thead>
            <tbody>
              {commands.map(([cmd, desc]) => (
                <tr>
                  <td><Code class="syntax-inline" code={`runcommand ${cmd}`} lang="shellscript" themes={codeThemes} transformers={inlineCodeTransformers} inline /></td>
                  <td>{desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="config-note">
          <h3>Project overrides</h3>
          <p>Overrides take precedence over cached detection and skip the detection agent.</p>
          <div class="table-wrap override-table">
            <table>
              <thead>
                <tr><th scope="col">Source</th><th scope="col">Format</th><th scope="col">Example</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>.claude-run</code><br /><code>.runcommand</code></td>
                  <td>One command per line. Add a <code>label:</code> prefix to name multiple services.</td>
                  <td><Code class="syntax-inline" code="web: pnpm dev" lang="yaml" themes={codeThemes} transformers={inlineCodeTransformers} inline /></td>
                </tr>
                <tr>
                  <td><code>Run:</code> in <code>CLAUDE.md</code></td>
                  <td>One command, outside fenced code examples.</td>
                  <td><Code class="syntax-inline" code="Run: docker compose up" lang="yaml" themes={codeThemes} transformers={inlineCodeTransformers} inline /></td>
                </tr>
              </tbody>
            </table>
          </div>
          <h3 class="config-env-heading">Environment variables</h3>
          <div class="table-wrap env-table">
            <table>
              <thead>
                <tr><th scope="col">Variable</th><th scope="col">What it does</th></tr>
              </thead>
              <tbody>
                <tr><td><code>RUNCOMMAND_MODEL</code></td><td>Selects the detection model. Claude uses <code>haiku</code> by default; other agents keep their own default.</td></tr>
                <tr><td><code>RUNCOMMAND_PORT_STYLE</code></td><td>Uses <code>url</code> for full localhost URLs or <code>compact</code> for short OSC 8 links such as <code>:5173</code>.</td></tr>
                <tr><td><code>RUNCOMMAND_COLORS</code></td><td>Sets the comma-separated ANSI colour codes used for multiple services, for example <code>36,33,35</code>.</td></tr>
                <tr><td><code>NO_COLOR</code></td><td>Removes ANSI colour from all output.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap foot-in">
        <span class="foot-brand"><span class="brand-mark">▶</span> runcommand
          <span class="foot-ver">v{version}{commit ? " · " : ""}{commit ? <a href={`${repo}/commit/${commit}`} rel="noopener">{commit}</a> : null}</span>
        </span>
        <span class="foot-links">
