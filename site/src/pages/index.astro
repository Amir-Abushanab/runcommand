---
import Layout from "../layouts/Layout.astro";
import Terminal from "../components/Terminal.astro";

const repo = "https://github.com/amir-abushanab/runcommand";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Inline a vendored favicon; onerror removes it, so a bad load leaves no broken
// icon (the fallback is no icon, never a misrendered one).
const favImg = (file) => `<img class="tool-fav" src="${base}/favicons/${file}" alt="" width="14" height="14" loading="lazy" onerror="this.remove()">`;
// A tool name linked to its site with its favicon. Omit `file` for no icon.
const toolLink = (href, label, file) => `<a class="tool-link" href="${href}" target="_blank" rel="noopener">${file ? favImg(file) : ""}<span>${label}</span></a>`;

const features = [
  { icon: "◆", title: "LLM-detected", body: "A quick headless call to your AI CLI — Claude by default; Gemini, Cursor, OpenCode, and more — reads your package.json scripts, lockfile and manifests to work out the real dev command: pnpm dev, cargo run, mix phx.server, docker compose up." },
  { icon: "⚡", title: "Cached, never blocking", body: "Detected once, then cached per project. The status line is a ~50ms cache read; detection runs in the background." },
  { icon: "↻", title: "Self-healing", body: "The cache is keyed to a fingerprint of your manifests. Edit a Makefile target or a package.json script and it re-detects on the next render. Nothing to remember." },
  { icon: "◉", title: "Live ports", body: "Shows the localhost servers actually running for this project, scoped by process working dir, as clickable links. Databases and other projects don't leak in." },
  { icon: "▤", title: "Runs everywhere", body: `One CLI across ${toolLink("https://claude.com/claude-code", "Claude Code", "claude.svg")}, ${toolLink("https://starship.rs", "starship", "starship.png")}, ${toolLink("https://opencode.ai", "OpenCode", "opencode.svg")}, and ${toolLink("https://github.com/QwenLM/qwen-code", "Qwen Code", "qwen.png")}, plus ${toolLink("https://github.com/openai/codex", "Codex")} once it ships a status-line hook. No hook? It rides your tmux status bar or shell prompt — around any TUI, aider and goose included.` },
  { icon: "✦", title: "Colorblind-safe", body: "Each service in a monorepo gets its own colour from a colorblind-safe palette. Labels tell them apart even when the colours can't." },
];

const steps = [
  { n: "1", title: "Detect", body: "Your AI CLI (Claude by default; Gemini, Cursor, OpenCode, …) reads the project's signals and returns the dev/run command (or several, for a monorepo)." },
  { n: "2", title: "Cache", body: "Saved per project under ~/.cache/runcommand, keyed to a hash of the manifests that define it." },
  { n: "3", title: "Serve", body: "Status lines and prompts read the cache instantly; live ports come from a short-cached lsof scan." },
  { n: "4", title: "Self-heal", body: "Change a manifest, the fingerprint changes, and a background re-detect refreshes the answer." },
];

const commands = [
  ["init", "Detect your tools and wire runcommand into each  ·  --dry-run --yes --surfaces"],
  ["statusline", "Render the run command + live ports (Claude Code / Qwen Code call this)"],
  ["prompt", "Plain run command for a shell prompt (non-blocking)"],
  ["promptline", "Run command + clickable ports, styled (starship module)"],
  ["ports", "This project's live localhost ports  ·  --links --urls --json --all"],
  ["json", "Structured { commands, ports } for plugins (the OpenCode plugin uses this)"],
  ["detect", "Detect now (asks the detection agent), print + cache"],
  ["get", "Print the cached command (detect if missing)"],
  ["refresh", "Re-detect  ·  --hint \"what's wrong\" to steer, --clear-hint to reset"],
  ["path", "Print the cache file path for a project"],
  ["agents", "Show the detection chain — which agents are installed  ·  --probe to test each"],
  ["uninstall", "Remove runcommand's wiring (restores what was there)"],
];

// color = brand colour shown on hover; near-black brands fall back to the theme
// text colour so they stay visible. osc8: false marks terminals without OSC 8.
// url = official homepage, opened in a new tab.
const terminals = [
  { slug: "ghostty", name: "Ghostty", color: "#3551F3", url: "https://ghostty.org" },
  { slug: "iterm2", name: "iTerm2", color: "var(--text)", url: "https://iterm2.com" },
  { slug: "wezterm", name: "WezTerm", color: "#4E49EE", url: "https://wezterm.org" },
  { slug: "kitty", name: "kitty", color: "#C0C81F", url: "https://sw.kovidgoyal.net/kitty/" },
  { slug: "alacritty", name: "Alacritty", color: "#F46D01", url: "https://alacritty.org" },
  { slug: "warp", name: "Warp", color: "#01A4FF", url: "https://www.warp.dev" },
  { slug: "windowsterminal", name: "Windows Terminal", color: "#4CC2FF", url: "https://github.com/microsoft/terminal" },
  { slug: "visualstudiocode", name: "VS Code", color: "#0098FF", url: "https://code.visualstudio.com" },
  { slug: "gnometerminal", name: "GNOME Terminal", color: "var(--text)", url: "https://help.gnome.org/users/gnome-terminal/stable/" },
  { slug: "apple", name: "Apple Terminal", color: "var(--text)", osc8: false, url: "https://support.apple.com/guide/terminal/welcome/mac" },
];

// Inline links for tools named in prose (opened in a new tab).
const tools = {
  claude: "https://claude.com/claude-code",
  starship: "https://starship.rs",
  qwen: "https://github.com/QwenLM/qwen-code",
  opencode: "https://opencode.ai",
  codex: "https://github.com/openai/codex",
};

// Prose with inline tool links + favicons, injected via set:html.
const installNote = `Detects the tools you have — ${toolLink(tools.claude, "Claude Code", "claude.svg")}, ${toolLink(tools.qwen, "Qwen", "qwen.png")}, ${toolLink(tools.starship, "starship", "starship.png")}, tmux — and wires each up, backing up every file it touches. Zero dependencies: just Node and your agent's CLI (<code>claude</code> by default). <a href="${repo}" rel="noopener">Full setup &rarr;</a>`;
const surfacesLead = `One CLI speaking ${toolLink(tools.claude, "Claude Code", "claude.svg")}'s <code>statusLine</code> contract (JSON in, a line out). Everything that copied that contract gets it for free, plus a native ${toolLink(tools.opencode, "OpenCode", "opencode.svg")} plugin.`;

const GH_PATH = "M8 .2a8 8 0 00-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.49c-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.2c0 .21.15.46.55.38A8 8 0 008 .2z";
---

<Layout
  title="runcommand: your project's run command, in the status bar"
  description="A tiny, dependency-free CLI that detects each project's run command and shows it, with live clickable localhost ports, in your Claude Code status bar, shell prompt, and more."
>
  <header class="nav">
    <div class="wrap nav-in">
      <a class="brand" href="#top"><span class="brand-mark">▶</span> runcommand</a>
      <nav class="nav-links">
        <a href="#how">How it works</a>
        <a href="#surfaces">Surfaces</a>
        <a href="#commands">Commands</a>
        <a href={repo} rel="noopener" class="nav-gh">
          <svg class="gh-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d={GH_PATH} /></svg>
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-in">
        <div class="hero-copy">
          <h1>Never hunt for the run command again.</h1>
          <p class="lead">
            Juggling a dozen repos? <strong>runcommand</strong> works out how to start each
            one (<code>pnpm dev</code>, <code>cargo run</code>, <code>docker compose up</code>)
            and shows it next to the localhost ports it's actually serving, right in your
            status bar and prompt.
          </p>
          <div class="cta">
            <a class="btn btn-primary" href="#how">See how it works</a>
            <a class="btn btn-ghost" href={repo} rel="noopener">
              <svg class="gh-icon" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d={GH_PATH} /></svg>
              View on GitHub
            </a>
          </div>
          <div class="install">
            <code id="install-cmd">runcommand init</code>
            <button class="copy" type="button" data-copy-target="install-cmd" aria-label="Copy command">Copy</button>
          </div>
          <p class="install-note" set:html={installNote}></p>
        </div>

        <div class="hero-demo" id="cc-widget" role="img" title="Click to replay"
             aria-label="In Claude Code, the /runcommand slash command detects the run command and shows it in the status line: pnpm dev, serving localhost:5173.">
          <Terminal title="Claude Code" caption="Type /runcommand — it detects the command and its live port. (click to replay)">
<span class="cc-box"><span class="cc-caret">&gt;</span> <span id="cc-typed" class="cc-typed">/runcommand</span><span id="cc-cursor" class="cc-cursor" hidden>▍</span></span>
<span class="ln"><span class="dim">[Opus] · principlestash.com · 42% context</span></span>
<span class="ln" id="cc-run"><span class="dim">▶</span> <span class="cyan">pnpm dev</span>  <span class="dim">◉</span> <span class="cc-port">:5173</span></span>
          </Terminal>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="features">
      <div class="wrap">
        <p class="eyebrow">Features</p>
        <h2>What it does</h2>
        <ul class="cards" role="list">
          {features.map((f) => (
            <li class="card">
              <span class="card-icon" aria-hidden="true">{f.icon}</span>
              <h3>{f.title}</h3>
              <p set:html={f.body}></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" class="how">
      <div class="wrap">
        <p class="eyebrow">How it works</p>
        <h2>Detect once, cache, serve, self-heal.</h2>
        <p class="lead">The status line never waits on the model. Detection is a background job behind a content-addressed cache.</p>
        <ol class="flow" role="list">
          {steps.map((s) => (
            <li class="step">
              <span class="step-n" aria-hidden="true">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>

        <div class="how-demos">
          <Terminal title="zsh · steering a wrong guess">
<span class="ln"><span class="green">❯</span> <span class="white">runcommand get</span></span>
<span class="ln"><span class="cyan">pnpm dev</span></span>
<span class="ln"><span class="green">❯</span> <span class="white">runcommand refresh --hint </span><span class="yellow">"it's the web app, not the api"</span></span>
<span class="ln"><span class="cyan">pnpm run dev:web</span>   <span class="comment"># saved, so re-detects won't regress</span></span>
          </Terminal>
          <Terminal title="pin it exactly · .claude-run">
<span class="ln"><span class="comment"># one command per line, optional label:</span></span>
<span class="ln"><span class="white">api:</span> go run ./cmd/server</span>
<span class="ln"><span class="white">web:</span> pnpm dev</span>
          </Terminal>
        </div>
      </div>
    </section>

    <!-- SURFACES -->
    <section id="surfaces" class="surfaces">
      <div class="wrap">
        <p class="eyebrow">Surfaces</p>
        <h2>The same answer, wherever you look.</h2>
        <p class="lead" set:html={surfacesLead}></p>

        <div class="surface-grid">
          <Terminal title="starship · shell prompt" caption="A right-aligned tagline; ports clickable via OSC 8.">
<span class="ln"><span class="row"><span><span class="magenta">~/Code/principlestash.com</span> <span class="dim">on</span> <span class="blue"> main</span></span><span><span class="dim">▶</span> <span class="cyan">pnpm dev</span> <span class="dim">·</span> <a href="http://localhost:5173">:5173</a></span></span></span>
<span class="ln"><span class="green">❯</span> <span class="dim">▍</span></span>
          </Terminal>

          <Terminal title="OpenCode · TUI footer" caption="A native Solid plugin rendering into app_bottom.">
<span class="ln"><span class="dim">◍ claude-sonnet · 18% · 2m04s</span></span>
<span class="ln"><span class="dim">▶</span> <span class="cyan">bun dev</span>  <span class="dim">◉</span> <a href="http://localhost:3000">:3000</a></span>
          </Terminal>

          <Terminal title="monorepo · distinct services" caption="Any stack, each its own colour and label.">
<span class="ln"><span class="dim">▶</span> <span class="dim">web:</span> <span class="cyan">pnpm dev</span> <span class="dim">·</span> <span class="dim">api:</span> <span class="magenta">mix phx.server</span> <span class="dim">·</span> <span class="dim">jobs:</span> <span class="green">cargo run</span></span>
          </Terminal>

          <Terminal title="first visit · non-blocking" caption="A placeholder while the background detect runs.">
<span class="ln"><span class="dim">◆ opus · new-thing · 88%</span></span>
<span class="ln"><span class="dim">▶ finding run command…</span></span>
          </Terminal>
        </div>

        <h3 class="compat-h">Clickable in every terminal</h3>
        <p class="lead">The ports are real links. ⌘-click (or your terminal's link modifier) opens them anywhere OSC 8 hyperlinks are supported. Hover a logo to see it in its colours:</p>
        <ul class="logos" role="list">
          {terminals.map((t) => (
            <li class="logo-item">
              <a href={t.url} target="_blank" rel="noopener" aria-label={t.name}>
                <span class="ico" style={`--logo:url("${base}/logos/${t.slug}.svg");--brand:${t.color}`}></span>
                <span>{t.name}{t.osc8 === false ? "*" : ""}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="compat-note">
          <strong>*</strong> Apple Terminal has no OSC 8, so runcommand's <code>url</code> port
          style prints the full <code>http://localhost:PORT</code>, which stays ⌘-clickable there.
          Konsole, foot, and any other terminal with OSC 8 support work too.
        </p>
      </div>
    </section>

    <!-- COMMANDS -->
    <section id="commands" class="commands">
      <div class="wrap">
        <p class="eyebrow">Reference</p>
        <h2>Commands</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th scope="col">Command</th><th scope="col">What it does</th></tr>
            </thead>
            <tbody>
              {commands.map(([cmd, desc]) => (
                <tr>
                  <td><code>runcommand {cmd}</code></td>
                  <td>{desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="lead" style="margin-block-start:1.5rem">
          Overrides that skip the model entirely: a <code>.claude-run</code> file, or a
          <code>Run:</code> line in <code>CLAUDE.md</code>. Tunable via env vars like
          <code>RUNCOMMAND_MODEL</code>, <code>RUNCOMMAND_PORT_STYLE</code>,
          <code>RUNCOMMAND_COLORS</code>, and <code>NO_COLOR</code>.
        </p>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap foot-in">
        <span><span class="brand-mark">▶</span> runcommand</span>
        <span class="foot-links">
          <a href={repo} rel="noopener">GitHub</a>
          <a href="#top">Back to top ↑</a>
        </span>
      </div>
    </footer>
  </main>

  <script is:inline>
    document.querySelectorAll(".copy").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const el = document.getElementById(btn.getAttribute("data-copy-target"));
        if (!el) return;
        try {
          await navigator.clipboard.writeText(el.textContent.trim());
          const prev = btn.textContent;
          btn.textContent = "Copied ✓";
          setTimeout(() => (btn.textContent = prev), 1400);
        } catch {}
      });
    });
  </script>

  <script is:inline>
    // Hero widget: type /runcommand, "detect", reveal the command + port. Plays
    // once when scrolled into view; click to replay. The end state lives in the
    // markup, so no-JS and reduced-motion users just see the result.
    (function () {
      const w = document.getElementById("cc-widget");
      const typed = document.getElementById("cc-typed");
      const cursor = document.getElementById("cc-cursor");
      const run = document.getElementById("cc-run");
      if (!w || !typed || !run) return;
      const CMD = "/runcommand";
      const RESULT = run.innerHTML; // captured final state from the markup
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
      let playing = false;
      async function play() {
        if (playing) return;
        playing = true;
        typed.textContent = "";
        if (cursor) cursor.hidden = false;
        run.innerHTML = "";
        for (const ch of CMD) { typed.textContent += ch; await sleep(60); }
        await sleep(380);
        if (cursor) cursor.hidden = true;
        run.innerHTML = '<span class="dim">▶ finding run command<span class="cc-dots"></span></span>';
        const dots = run.querySelector(".cc-dots");
        let n = 0;
        const t = setInterval(() => { n = (n + 1) % 4; dots.textContent = ".".repeat(n); }, 250);
        await sleep(1450);
        clearInterval(t);
        run.innerHTML = RESULT;
        run.classList.add("cc-reveal");
        setTimeout(() => run.classList.remove("cc-reveal"), 400);
        playing = false;
      }
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const io = new IntersectionObserver((es) => {
        if (es[0].isIntersecting) { io.disconnect(); play(); }
      }, { threshold: 0.5 });
      io.observe(w);
      w.addEventListener("click", () => play());
    })();
  </script>

  <style>
    /* nav */
    .nav {
      position: sticky; inset-block-start: 0; z-index: 10;
      background: color-mix(in oklab, var(--bg) 82%, transparent);
      backdrop-filter: blur(10px);
      border-block-end: 1px solid var(--border);
    }
    .nav-in { display: flex; align-items: center; justify-content: space-between; padding-block: 0.7rem; }
    .brand { font-weight: 700; text-decoration: none; color: var(--text); display: inline-flex; align-items: center; gap: 0.5ch; }
    .brand-mark { color: var(--accent); }
    .nav-links { display: flex; gap: clamp(0.7rem, 3vw, 1.6rem); align-items: center; flex-wrap: wrap; }
    .nav-links a { color: var(--muted); text-decoration: none; font-size: 0.92rem; }
    .nav-links a:hover { color: var(--text); }
    .nav-gh { display: inline-flex; align-items: center; gap: 0.4ch; }
    .gh-icon { vertical-align: -0.18em; flex: none; }

    /* hero */
    .hero { padding-block: clamp(2.5rem, 8vw, 5rem); }
    .hero-in { display: grid; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; }
    @media (min-width: 900px) { .hero-in { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); } }
    h1 { font-size: clamp(2.1rem, 6vw, 3.6rem); margin-block-end: 1rem; }
    .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-block: 1.5rem; }
    .btn .gh-icon { margin-inline-end: 0.15rem; }
    .install {
      display: flex; align-items: center; gap: 0.5rem;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius-sm); padding: 0.5rem 0.5rem 0.5rem 0.9rem;
      max-inline-size: 100%;
    }
    .install code { font-family: var(--mono); font-size: 0.85rem; color: var(--text); overflow-x: auto; white-space: nowrap; min-inline-size: 0; }
    .copy {
      margin-inline-start: auto; flex: none;
      font: 600 0.8rem/1 var(--font); cursor: pointer;
      background: var(--surface-2); color: var(--text);
      border: 1px solid var(--border); border-radius: 7px; padding: 0.45rem 0.7rem;
    }
    .copy:hover { border-color: var(--accent); }
    .install-note { color: var(--muted); font-size: 0.85rem; margin-block-start: 0.7rem; }
    .hero code, .install-note code, .lead code, .commands code, .compat-note code {
      font-family: var(--mono); font-size: 0.86em;
      background: var(--surface-2); padding: 0.1em 0.4em; border-radius: 5px;
    }

    /* section headings */
    .features h2, .how h2, .surfaces h2, .commands h2 { font-size: clamp(1.6rem, 3.5vw, 2.3rem); margin-block: 0.4rem 1.5rem; }
    .compat-h { font-size: clamp(1.25rem, 2.6vw, 1.6rem); margin-block: 3.2rem 0.4rem; padding-block-start: 2.4rem; border-block-start: 1px solid var(--border); }

    /* features */
    .cards { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.3rem; }
    .card-icon { color: var(--accent); font-size: 1.4rem; }
    .card h3 { font-size: 1.05rem; margin-block: 0.6rem 0.35rem; }
    .card p { color: var(--muted); font-size: 0.95rem; }

    /* how */
    .how { background: var(--surface); border-block: 1px solid var(--border); }
    .flow { list-style: none; padding: 0; margin-block: 2rem; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .step { position: relative; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.3rem; }
    .step-n {
      display: grid; place-content: center; inline-size: 2rem; block-size: 2rem;
      border-radius: 50%; background: var(--accent); color: var(--accent-ink);
      font-weight: 700; font-family: var(--mono); margin-block-end: 0.7rem;
    }
    .step h3 { font-size: 1.05rem; margin-block-end: 0.3rem; }
    .step p { color: var(--muted); font-size: 0.93rem; }
    .how-demos { display: grid; gap: 1.2rem; margin-block-start: 2rem; }
    @media (min-width: 780px) { .how-demos { grid-template-columns: 1.3fr 1fr; align-items: start; } }

    /* surfaces */
    .surface-grid { display: grid; gap: 1.3rem; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); margin-block-start: 1.5rem; }

    /* compatibility (merged into surfaces) */
    .logos { list-style: none; padding: 0; margin-block: 1.6rem; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); }
    .logo-item { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); transition: border-color 0.14s ease; }
    .logo-item a { display: flex; flex-direction: column; align-items: center; gap: 0.65rem; padding: 1.3rem 0.5rem; text-decoration: none; color: inherit; border-radius: inherit; }
    .logo-item:hover { border-color: color-mix(in oklab, var(--accent) 40%, var(--border)); }
    .logo-item a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .logo-item .ico {
      inline-size: 30px; block-size: 30px; display: block;
      background-color: var(--muted);
      -webkit-mask: var(--logo) center / contain no-repeat;
      mask: var(--logo) center / contain no-repeat;
      transition: background-color 0.14s ease;
    }
    .logo-item:hover .ico { background-color: var(--brand); }
    .logo-item span { color: var(--muted); font-size: 0.82rem; text-align: center; }
    .compat-note { color: var(--muted); font-size: 0.92rem; max-inline-size: 72ch; }
    .compat-note strong { color: var(--text); }

    /* commands */
    .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
    table { border-collapse: collapse; inline-size: 100%; font-size: 0.95rem; }
    th, td { text-align: start; padding: 0.8rem 1rem; border-block-end: 1px solid var(--border); vertical-align: top; }
    thead th { color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
    tbody tr:last-child td { border-block-end: 0; }
    td code { font-family: var(--mono); font-size: 0.88rem; color: var(--accent); white-space: nowrap; }

    /* footer */
    .foot { border-block-start: 1px solid var(--border); background: var(--surface); }
    .foot-in { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding-block: 2rem; color: var(--muted); }
    .foot-links { display: flex; gap: 1.2rem; }
    .foot-links a { color: var(--muted); text-decoration: none; }
    .foot-links a:hover { color: var(--text); }
  </style>
</Layout>
